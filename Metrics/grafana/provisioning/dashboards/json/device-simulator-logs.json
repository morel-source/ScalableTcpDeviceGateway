        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": false,
        "sizing": "manual",
        "valueMode": "color"
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki-ds" },
        "editorMode": "builder",
        "expr": "sum by(level) (count_over_time({Application=\"TcpDeviceSimulator\"} [$__range]))",
        "legendFormat": "{{level}}",
        "queryType": "range",
        "refId": "A"
      }],
      "title": "Log Count by Level",
      "type": "bargauge"
    },


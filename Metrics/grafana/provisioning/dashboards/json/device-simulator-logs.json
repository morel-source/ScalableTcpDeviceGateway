          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "debug" }, "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "blue", "value": 0 }] } }] },
          { "matcher": { "id": "byName", "options": "info" }, "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }] } }] },
          { "matcher": { "id": "byName", "options": "warning" }, "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "yellow", "value": 0 }] } }] },
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }] } }] }
        ]
